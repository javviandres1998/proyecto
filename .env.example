# === API de Noticias ===
NEWS_API_KEY=tu_newsapi_key_aqui

# === Configuración SMTP ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail

# === Destinatario(s) del Newsletter ===
# Para múltiples destinatarios separar con comas: email1@gmail.com,email2@gmail.com
RECIPIENT_EMAIL=destino@gmail.com

# === Configuración del Newsletter ===
SEND_HOUR=8
TIMEZONE=Europe/Madrid
MAX_ARTICLES_PER_CATEGORY=5
NEWS_LANGUAGE=es,en

# === Rutas del sistema (ajustar según VPS) ===
LOG_FILE=/var/log/newsletter.log
